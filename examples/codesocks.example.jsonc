{
  // CodeSocks example — starts disabled (enabled false) so no placeholder
  // proxy is ever exposed. Switch to true only after configuring a real proxy.
  "$schema": "../codesocks.schema.json",
  "enabled": false,
  "proxies": {
    // Example local proxy (socks5h on localhost). Use {env:NAME} for credentials:
    // "socks5h://{env:PROXY_USER}:{env:PROXY_PASS}@127.0.0.1:1080"
    "local": "socks5h://127.0.0.1:1080"
  },
  "providers": {
    // Each provider points at a proxy and lists exact allowed origins.
    "openai": {
      "proxy": "local",
      "allowedOrigins": ["https://api.openai.com"],
      "maxConcurrent": 2,
      "minIntervalMs": 0,
      "timeoutMs": 120000,
      "maxQueueWaitMs": 120000
    }
  }
}
