{
  "name": "@hallaxius/codesocks",
  "version": "0.1.3",
  "description": "Route selected OpenCode V2 providers through HTTP, HTTPS, or SOCKS proxies without changing baseURL.",
  "license": "Apache-2.0",
  "author": "Hallaxius",
  "repository": {
    "type": "git",
    "url": "https://github.com/Hallaxius/codesocks.git"
  },
  "homepage": "https://github.com/Hallaxius/codesocks#readme",
  "bugs": "https://github.com/Hallaxius/codesocks/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "proxy",
    "http-proxy",
    "socks",
    "socks5",
    "egress",
    "rate-limit"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "module": "dist/index.js",
  "exports": {
    "./server": {
      "types": "./dist/index.d.ts",
      "import": "./server.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/src/tui.d.ts",
      "import": "./dist/src/tui.js"
    },
    "./package.json": "./package.json"
  },
  "files": ["dist", "server.js", "LICENSE", "codesocks.schema.json", "examples", "README.md"],
  "scripts": {
    "lint": "node scripts/lint-docs.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && bun test tests",
    "check": "bun run typecheck && bun run test",
    "smoke:opencode": "bun run build && node scripts/smoke-opencode.mjs",
    "prepack": "bun run check"
  },
  "dependencies": {
    "http-proxy-agent": "9.1.0",
    "https-proxy-agent": "9.1.0",
    "jsonc-parser": "3.3.1",
    "socks-proxy-agent": "10.1.0"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.22",
    "@types/bun": "1.4.2",
    "@types/node": "24.10.1",
    "markdownlint": "0.41.1",
    "typescript": "7.0.2"
  },
  "overrides": {
    "katex": "0.18.2"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.0.15 <3"
  }
}
